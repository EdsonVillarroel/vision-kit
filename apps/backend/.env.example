# ============================================================================
# Vision Kit Backend — Variables de entorno
# Copiar a .env y completar con valores reales. NUNCA commitear .env.
# Generar secrets con: openssl rand -base64 64
# ============================================================================

# ── Entorno ────────────────────────────────────────────────────────────────
NODE_ENV="development"           # development | production
PORT=3000

# ── Base de datos (Supabase PostgreSQL) ────────────────────────────────────
# Connection pooler (pgBouncer) — recomendado para serverless / runtimes cortos
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection — usar para migraciones (prisma migrate)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Supabase API (storage de imágenes, RLS bypass desde backend) ───────────
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGc..."   # service_role key — NUNCA exponer al cliente

# ── JWT — Tenant users (profiles) ──────────────────────────────────────────
# Mínimo 64 bytes random. Distinto al de platform.
JWT_SECRET="REPLACE_ME_openssl_rand_base64_64"
JWT_EXPIRES_IN="7d"

# ── JWT — Platform admins (separado para reducir blast radius) ─────────────
# DEBE ser distinto a JWT_SECRET. Si se filtra uno, el otro sigue seguro.
JWT_PLATFORM_SECRET="REPLACE_ME_DIFFERENT_openssl_rand_base64_64"
JWT_PLATFORM_EXPIRES_IN="1d"

# ── CORS — orígenes permitidos (separados por coma) ────────────────────────
# Dev: panel óptica + admin + landing
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"
# Prod ejemplo:
# CORS_ORIGINS="https://app.visionkit.com,https://admin.visionkit.com,https://vision-2020-hd.visionkit.com"

# ── Logging (Pino) ─────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal — default: info en prod, debug en dev
LOG_LEVEL="info"

# ── Sentry — error tracking (opt-in: si SENTRY_DSN está vacío, se desactiva)
# Crear proyecto en https://sentry.io/ y copiar el DSN
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"      # production | staging | development
SENTRY_RELEASE=""                     # opcional, ej: vision-kit-backend@1.0.0
SENTRY_TRACES_SAMPLE_RATE="0.1"       # 0.0–1.0 — muestreo de performance traces
