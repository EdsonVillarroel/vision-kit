generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// MULTI-TENANT
// ─────────────────────────────────────────

enum TenantStatus {
  active
  suspended
  cancelled

  @@map("tenant_status")
}

model Tenant {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  logoUrl        String?      @map("logo_url")
  primaryColor   String       @default("#6366f1") @map("primary_color")
  secondaryColor String       @default("#4f46e5") @map("secondary_color")
  accentColor    String       @default("#818cf8") @map("accent_color")
  domain         String?
  status         TenantStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  users           User[]
  patients        Patient[]
  appointments    Appointment[]
  medicalRecords  MedicalRecord[]
  clinicalExams   ClinicalExam[]
  products        Product[]
  stockMovements  StockMovement[]
  sales           Sale[]
  saleItems       SaleItem[]
  payments        Payment[]
  settings        ClinicSettings[]
  publicBookings  PublicBooking[]
  subscriptions   Subscription[]

  @@map("tenants")
}

enum BillingPeriod {
  monthly
  yearly

  @@map("billing_period")
}

model SubscriptionPlan {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  price         Decimal       @db.Decimal(10, 2)
  currency      String        @default("BOB")
  billingPeriod BillingPeriod @default(monthly) @map("billing_period")
  maxUsers      Int           @map("max_users")
  maxPatients   Int           @map("max_patients")
  maxProducts   Int           @map("max_products")
  maxStorageMb  Int           @map("max_storage_mb")
  features      Json          @default("{}")
  isActive      Boolean       @default(true) @map("is_active")
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
  trial

  @@map("subscription_status")
}

model Subscription {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  planId       String             @map("plan_id")
  status       SubscriptionStatus @default(active)
  startedAt    DateTime           @default(now()) @map("started_at")
  expiresAt    DateTime?          @map("expires_at")
  cancelledAt  DateTime?          @map("cancelled_at")
  paymentNotes String?            @map("payment_notes")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

enum PlatformAdminStatus {
  active
  inactive

  @@map("platform_admin_status")
}

model PlatformAdmin {
  id           String              @id @default(uuid())
  email        String              @unique
  passwordHash String              @map("password_hash")
  name         String
  status       PlatformAdminStatus @default(active)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@map("platform_admins")
}

// ─────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────

enum UserRole {
  super_admin
  admin
  manager
  optician

  @@map("user_role")
}

enum UserStatus {
  active
  inactive

  @@map("user_status")
}

// Maps to the "profiles" table in Supabase.
// NestJS manages auth independently (passwordHash).
model User {
  id           String     @id @default(uuid())
  tenantId     String     @default(dbgenerated()) @map("tenant_id")
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  role         UserRole   @default(optician)
  avatarUrl    String?    @map("avatar_url")
  phone        String?
  commissionRate Decimal    @default(0) @db.Decimal(5,2) @map("commission_rate")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  appointments   Appointment[]   @relation("PractitionerAppointments")
  sales          Sale[]
  medicalRecords MedicalRecord[]
  clinicalExams  ClinicalExam[]
  stockMovements StockMovement[]

  @@index([tenantId])
  @@map("profiles")
}

// ─────────────────────────────────────────
// PATIENTS
// ─────────────────────────────────────────

enum PatientGender {
  male
  female
  other

  @@map("gender_type")
}

enum PatientStatus {
  frequent
  normal
  warning

  @@map("patient_status")
}

model Patient {
  id                String        @id @default(uuid())
  tenantId          String        @default(dbgenerated()) @map("tenant_id")
  identificationId  String        @map("identification_id")
  firstName         String        @map("first_name")
  lastName          String        @map("last_name")
  dateOfBirth       DateTime?     @db.Date @map("date_of_birth")
  gender            PatientGender?
  phone             String?
  email             String?
  address           String?
  city              String?
  state             String?
  zipCode           String?       @map("zip_code")
  allergies         String[]      @default([])
  medicalConditions String[]      @default([]) @map("medical_conditions")
  status            PatientStatus @default(normal)
  visitCount        Int           @default(0) @map("visit_count")
  totalSpent        Decimal       @default(0) @db.Decimal(10, 2) @map("total_spent")
  notes             String?
  warningReason     String?       @map("warning_reason")
  lastVisit         DateTime?     @map("last_visit")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  insurance        PatientInsurance?
  emergencyContact PatientEmergencyContact?
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  clinicalExams    ClinicalExam[]
  sales            Sale[]

  @@unique([tenantId, identificationId])
  @@index([tenantId])
  @@index([identificationId])
  @@index([lastName, firstName])
  @@index([status])
  @@map("patients")
}

model PatientInsurance {
  id           String  @id @default(uuid())
  patientId    String  @unique @map("patient_id")
  provider     String
  policyNumber String  @map("policy_number")
  groupNumber  String? @map("group_number")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_insurances")
}

model PatientEmergencyContact {
  id           String @id @default(uuid())
  patientId    String @unique @map("patient_id")
  name         String
  relationship String
  phone        String

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_emergency_contacts")
}

// ─────────────────────────────────────────
// APPOINTMENTS
// ─────────────────────────────────────────

enum AppointmentType {
  eye_exam             @map("eye-exam")
  contact_lens_fitting @map("contact-lens-fitting")
  followup
  emergency
  frame_selection      @map("frame-selection")
  adjustment

  @@map("appointment_type")
}

enum AppointmentStatus {
  scheduled
  confirmed
  in_progress @map("in-progress")
  completed
  cancelled
  no_show     @map("no-show")

  @@map("appointment_status")
}

model Appointment {
  id                 String            @id @default(uuid())
  tenantId           String            @default(dbgenerated()) @map("tenant_id")
  appointmentNumber  String            @map("appointment_number")
  patientId          String            @map("patient_id")
  practitionerId     String            @map("practitioner_id")
  date               DateTime          @db.Date
  time               String
  duration           Int               @default(30)
  endTime            String            @map("end_time")
  type               AppointmentType
  status             AppointmentStatus @default(scheduled)
  reason             String?
  notes              String?
  reminderSent       Boolean           @default(false) @map("reminder_sent")
  reminderSentAt     DateTime?         @map("reminder_sent_at")
  medicalRecordId    String?           @map("medical_record_id")
  createdById        String            @map("created_by_id")
  confirmedAt        DateTime?         @map("confirmed_at")
  completedAt        DateTime?         @map("completed_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  cancellationReason String?           @map("cancellation_reason")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  practitioner  User           @relation("PractitionerAppointments", fields: [practitionerId], references: [id])
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id])

  @@unique([tenantId, appointmentNumber])
  @@index([tenantId])
  @@index([patientId])
  @@index([practitionerId])
  @@index([date])
  @@index([status])
  @@map("appointments")
}

// ─────────────────────────────────────────
// MEDICAL RECORDS
// ─────────────────────────────────────────

enum ExamType {
  routine
  emergency
  followup
  contact_lens @map("contact-lens")

  @@map("exam_type")
}

model MedicalRecord {
  id             String   @id @default(uuid())
  tenantId       String   @default(dbgenerated()) @map("tenant_id")
  patientId      String   @map("patient_id")
  practitionerId String   @map("practitioner_id")
  date           DateTime @db.Date
  examType       ExamType @default(routine) @map("exam_type")

  // Visual Acuity
  vaRightUncorrected String? @map("va_right_uncorrected")
  vaRightCorrected   String? @map("va_right_corrected")
  vaLeftUncorrected  String? @map("va_left_uncorrected")
  vaLeftCorrected    String? @map("va_left_corrected")

  // Refraction
  refractionRightSphere   Decimal? @db.Decimal(5, 2) @map("refraction_right_sphere")
  refractionRightCylinder Decimal? @db.Decimal(5, 2) @map("refraction_right_cylinder")
  refractionRightAxis     Int?     @map("refraction_right_axis")
  refractionRightAdd      Decimal? @db.Decimal(5, 2) @map("refraction_right_add")
  refractionRightPrism    Decimal? @db.Decimal(5, 2) @map("refraction_right_prism")
  refractionRightBase     String?  @map("refraction_right_base")
  refractionRightPd       Decimal? @db.Decimal(4, 1) @map("refraction_right_pd")

  refractionLeftSphere    Decimal? @db.Decimal(5, 2) @map("refraction_left_sphere")
  refractionLeftCylinder  Decimal? @db.Decimal(5, 2) @map("refraction_left_cylinder")
  refractionLeftAxis      Int?     @map("refraction_left_axis")
  refractionLeftAdd       Decimal? @db.Decimal(5, 2) @map("refraction_left_add")
  refractionLeftPrism     Decimal? @db.Decimal(5, 2) @map("refraction_left_prism")
  refractionLeftBase      String?  @map("refraction_left_base")
  refractionLeftPd        Decimal? @db.Decimal(4, 1) @map("refraction_left_pd")

  // Prescription
  prescriptionRightSphere   Decimal? @db.Decimal(5, 2) @map("prescription_right_sphere")
  prescriptionRightCylinder Decimal? @db.Decimal(5, 2) @map("prescription_right_cylinder")
  prescriptionRightAxis     Int?     @map("prescription_right_axis")
  prescriptionRightAdd      Decimal? @db.Decimal(5, 2) @map("prescription_right_add")
  prescriptionRightPd       Decimal? @db.Decimal(4, 1) @map("prescription_right_pd")
  prescriptionLeftSphere    Decimal? @db.Decimal(5, 2) @map("prescription_left_sphere")
  prescriptionLeftCylinder  Decimal? @db.Decimal(5, 2) @map("prescription_left_cylinder")
  prescriptionLeftAxis      Int?     @map("prescription_left_axis")
  prescriptionLeftAdd       Decimal? @db.Decimal(5, 2) @map("prescription_left_add")
  prescriptionLeftPd        Decimal? @db.Decimal(4, 1) @map("prescription_left_pd")
  prescriptionFrameType     String?  @map("prescription_frame_type")
  prescriptionLensType      String?  @map("prescription_lens_type")

  // Intraocular pressure
  iopRight Int? @map("iop_right")
  iopLeft  Int? @map("iop_left")

  // Eye health
  eyeHealthRightAnterior  String? @map("eye_health_right_anterior")
  eyeHealthRightPosterior String? @map("eye_health_right_posterior")
  eyeHealthRightNotes     String? @map("eye_health_right_notes")
  eyeHealthLeftAnterior   String? @map("eye_health_left_anterior")
  eyeHealthLeftPosterior  String? @map("eye_health_left_posterior")
  eyeHealthLeftNotes      String? @map("eye_health_left_notes")

  diagnosis            String[] @default([])
  notes                String?
  nextVisitRecommended DateTime? @db.Date @map("next_visit_recommended")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  patient       Patient       @relation(fields: [patientId], references: [id])
  practitioner  User          @relation(fields: [practitionerId], references: [id])
  appointments  Appointment[]
  sales         Sale[]
  clinicalExam  ClinicalExam?

  @@index([tenantId])
  @@index([patientId])
  @@index([date])
  @@map("medical_records")
}

// ─────────────────────────────────────────
// CLINICAL EXAMS
// ─────────────────────────────────────────

model ClinicalExam {
  id              String   @id @default(uuid())
  tenantId        String   @default(dbgenerated()) @map("tenant_id")
  examNumber      String   @map("exam_number")
  patientId       String   @map("patient_id")
  examinerId      String   @map("examiner_id")
  medicalRecordId String?  @unique @map("medical_record_id")
  date            DateTime @db.Date

  // Far vision — right eye
  farRightSphere   Decimal  @db.Decimal(5, 2) @map("far_right_sphere")
  farRightCylinder Decimal  @db.Decimal(5, 2) @map("far_right_cylinder")
  farRightAxis     Int      @map("far_right_axis")
  farRightPrism    Decimal  @default(0) @db.Decimal(5, 2) @map("far_right_prism")
  farRightBase     String   @default("") @map("far_right_base")
  farRightAddition Decimal? @db.Decimal(5, 2) @map("far_right_addition")

  // Far vision — left eye
  farLeftSphere    Decimal  @db.Decimal(5, 2) @map("far_left_sphere")
  farLeftCylinder  Decimal  @db.Decimal(5, 2) @map("far_left_cylinder")
  farLeftAxis      Int      @map("far_left_axis")
  farLeftPrism     Decimal  @default(0) @db.Decimal(5, 2) @map("far_left_prism")
  farLeftBase      String   @default("") @map("far_left_base")
  farLeftAddition  Decimal? @db.Decimal(5, 2) @map("far_left_addition")

  // Near vision — right eye
  nearRightSphere   Decimal? @db.Decimal(5, 2) @map("near_right_sphere")
  nearRightCylinder Decimal? @db.Decimal(5, 2) @map("near_right_cylinder")
  nearRightAxis     Int?     @map("near_right_axis")
  nearRightPrism    Decimal? @db.Decimal(5, 2) @map("near_right_prism")
  nearRightBase     String?  @map("near_right_base")

  // Near vision — left eye
  nearLeftSphere    Decimal? @db.Decimal(5, 2) @map("near_left_sphere")
  nearLeftCylinder  Decimal? @db.Decimal(5, 2) @map("near_left_cylinder")
  nearLeftAxis      Int?     @map("near_left_axis")
  nearLeftPrism     Decimal? @db.Decimal(5, 2) @map("near_left_prism")
  nearLeftBase      String?  @map("near_left_base")

  // Pupillary distance
  pdRight     Decimal  @db.Decimal(4, 1) @map("pd_right")
  pdLeft      Decimal  @db.Decimal(4, 1) @map("pd_left")
  pdNearRight Decimal? @db.Decimal(4, 1) @map("pd_near_right")
  pdNearLeft  Decimal? @db.Decimal(4, 1) @map("pd_near_left")

  // Frame measurements
  frameHeight Decimal @db.Decimal(5, 1) @map("frame_height")
  frameRight  Decimal @db.Decimal(5, 1) @map("frame_right")
  frameLeft   Decimal @db.Decimal(5, 1) @map("frame_left")

  lensDataRight String?  @map("lens_data_right")
  lensDataLeft  String?  @map("lens_data_left")
  observations  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  examiner      User           @relation(fields: [examinerId], references: [id])
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id])

  @@unique([tenantId, examNumber])
  @@index([tenantId])
  @@index([patientId])
  @@map("clinical_exams")
}

// ─────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────

enum ProductCategory {
  frames
  lenses
  sunglasses
  contact_lenses @map("contact-lenses")
  accessories
  solutions

  @@map("product_category")
}

enum ProductStatus {
  in_stock
  low_stock
  out_of_stock
  discontinued

  @@map("product_status")
}

model Product {
  id           String          @id @default(uuid())
  tenantId     String          @default(dbgenerated()) @map("tenant_id")
  sku          String
  name         String
  category     ProductCategory
  brand        String?
  model        String?
  costPrice    Decimal         @db.Decimal(10, 2) @map("cost_price")
  sellingPrice Decimal         @db.Decimal(10, 2) @map("selling_price")
  discount     Decimal?        @db.Decimal(5, 2)
  stock        Int             @default(0)
  minStock     Int             @default(0) @map("min_stock")
  maxStock     Int?            @map("max_stock")
  status       ProductStatus   @default(in_stock)
  images       String[]        @default([])
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  specifications ProductSpecification?
  supplier       ProductSupplier?
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([category])
  @@index([status])
  @@index([sku])
  @@map("products")
}

model ProductSpecification {
  id        String  @id @default(uuid())
  productId String  @unique @map("product_id")

  frameType    String?  @map("frame_type")
  material     String?
  color        String?
  lensSize     Decimal? @db.Decimal(4, 1) @map("lens_size")
  bridge       Decimal? @db.Decimal(4, 1)
  temple       Decimal? @db.Decimal(5, 1)

  lensType     String?  @map("lens_type")
  lensMaterial String?  @map("lens_material")
  index        Decimal? @db.Decimal(3, 2)
  coatings     String[] @default([])

  baseCurve Decimal? @db.Decimal(4, 2) @map("base_curve")
  diameter  Decimal? @db.Decimal(4, 1)
  power     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_specifications")
}

model ProductSupplier {
  id        String  @id @default(uuid())
  productId String  @unique @map("product_id")
  name      String
  contact   String?
  email     String?
  phone     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_suppliers")
}

enum StockMovementType {
  in
  out
  adjustment

  @@map("movement_type")
}

model StockMovement {
  id            String            @id @default(uuid())
  tenantId      String            @default(dbgenerated()) @map("tenant_id")
  productId     String            @map("product_id")
  performedById String            @map("performed_by_id")
  type          StockMovementType
  quantity      Int
  previousStock Int               @map("previous_stock")
  newStock      Int               @map("new_stock")
  reason        String
  reference     String?
  notes         String?
  date          DateTime          @db.Date
  createdAt     DateTime          @default(now()) @map("created_at")

  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
  performedBy User    @relation(fields: [performedById], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([date])
  @@map("stock_movements")
}

// ─────────────────────────────────────────
// SALES
// ─────────────────────────────────────────

enum PaymentMethod {
  cash
  card
  transfer
  check
  mixed

  @@map("payment_method")
}

enum SaleStatus {
  pending
  completed
  cancelled
  refunded

  @@map("sale_status")
}

model Sale {
  id                   String        @id @default(uuid())
  tenantId             String        @default(dbgenerated()) @map("tenant_id")
  saleNumber           String        @map("sale_number")
  patientId            String        @map("patient_id")
  soldById             String        @map("sold_by_id")
  medicalRecordId      String?       @map("medical_record_id")
  date                 DateTime      @db.Date
  subtotal             Decimal       @db.Decimal(10, 2)
  discount             Decimal       @default(0) @db.Decimal(10, 2)
  tax                  Decimal       @db.Decimal(10, 2)
  total                Decimal       @db.Decimal(10, 2)
  paymentMethod        PaymentMethod @map("payment_method")
  prescriptionRequired Boolean       @default(false) @map("prescription_required")
  status               SaleStatus    @default(pending)
  notes                String?
  warrantyExpiryDate   DateTime?     @db.Date @map("warranty_expiry_date")
  warrantyTerms        String?       @map("warranty_terms")
  cancellationReason   String?       @map("cancellation_reason")
  completedAt          DateTime?     @map("completed_at")
  cancelledAt          DateTime?     @map("cancelled_at")
  refundedAt           DateTime?     @map("refunded_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  soldBy        User           @relation(fields: [soldById], references: [id])
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  items         SaleItem[]
  payments      Payment[]

  @@unique([tenantId, saleNumber])
  @@index([tenantId])
  @@index([patientId])
  @@index([date])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(uuid())
  tenantId    String  @default(dbgenerated()) @map("tenant_id")
  saleId      String  @map("sale_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  productSku  String  @map("product_sku")
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2) @map("unit_price")
  discount    Decimal @default(0) @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@map("sale_items")
}

model Payment {
  id        String        @id @default(uuid())
  tenantId  String        @default(dbgenerated()) @map("tenant_id")
  saleId    String        @map("sale_id")
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  reference String?
  createdAt DateTime      @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  sale   Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payments")
}

// ─────────────────────────────────────────
// CLINIC SETTINGS
// ─────────────────────────────────────────

model ClinicSettings {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated()) @map("tenant_id")
  name      String
  rfc       String?
  address   String?
  city      String?
  state     String?
  zipCode   String?  @map("zip_code")
  phone     String?
  email     String?
  website   String?
  logo         String?
  primaryColor String?  @map("primary_color")
  accentColor  String?  @map("accent_color")
  taxRate       Decimal  @default(0.13) @db.Decimal(4, 2) @map("tax_rate")
  currency      String   @default("BOB")
  businessHours Json?    @map("business_hours")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId])
  @@index([tenantId])
  @@map("clinic_settings")
}

// ─────────────────────────────────────────
// PUBLIC PORTAL — RESERVAS ONLINE
// ─────────────────────────────────────────

enum BookingStatus {
  pending
  confirmed
  cancelled

  @@map("booking_status")
}

model PublicBooking {
  id            String        @id @default(uuid())
  tenantId      String        @default(dbgenerated()) @map("tenant_id")
  name          String
  phone         String
  email         String?
  serviceType   String        @map("service_type")
  preferredDate DateTime      @db.Date @map("preferred_date")
  preferredTime String?       @map("preferred_time")
  notes         String?
  status        BookingStatus @default(pending)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([preferredDate])
  @@map("public_bookings")
}
